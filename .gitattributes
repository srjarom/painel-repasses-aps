# Mantém os arquivos de texto sempre com quebra de linha LF (igual ao .editorconfig),
# para o histórico não mostrar "mudanças" falsas entre Windows e outros sistemas.
* text=auto eol=lf

# Arquivos binários: nunca mexer
*.png    binary
*.ico    binary
*.jpg    binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.pdf    binary
*.xlsx   binary
